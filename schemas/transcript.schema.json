{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholarship:transcript:v1",
  "title": "Private transcript evidence",
  "type": "object",
  "required": [
    "rules",
    "courses"
  ],
  "properties": {
    "rules": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "unconfirmed"
          ]
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "credits",
          "score",
          "include",
          "status",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "term": {
            "type": "string"
          },
          "raw_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "credits": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "include": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "exclusion_reason": {
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "uncertain",
              "missing"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "ranks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "period",
          "position",
          "population",
          "status",
          "source"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "population": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "status": {
            "enum": [
              "confirmed",
              "uncertain",
              "missing"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "application_value",
          "transcript_value",
          "application_source",
          "transcript_source"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "application_value": {},
          "transcript_value": {},
          "application_source": {
            "$ref": "#/$defs/source"
          },
          "transcript_source": {
            "$ref": "#/$defs/source"
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "document_id",
        "page",
        "locator"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "raw_text",
        "value",
        "status",
        "source"
      ],
      "properties": {
        "raw_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {},
        "status": {
          "enum": [
            "confirmed",
            "uncertain",
            "missing"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
